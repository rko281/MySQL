!Socket2 methodsFor!

getBooleanOption: option level: anInteger

	| optval |

	optval := AnsiString newFixed: 1.

	self getSocketOption: option level: anInteger into: optval.

	^optval first ~= $\x00!

getSocketOption: option level: anInteger into: aString

	| optlen |

	optlen := SDWORD new.
	optlen value: aString size.

	(WS2_32Library default 
		getsockopt: self asParameter
		level:  anInteger
		optname: option
		optval: aString
		optlen: optlen) = 0 ifFalse: [self socketError].

	^aString first: optlen value!

setBooleanOption: option level: anInteger value: aBoolean

	| optval |

	optval := AnsiString newFixed: 1.
	optval at: 1 put: (Character value: aBoolean asDword).

	self setSocketOption: option level: anInteger value: optval!

setSocketOption: option level: anInteger value: aString

	(WS2_32Library default 
		setsockopt: self asParameter
		level: anInteger
		optname: option
		optval: aString
		optlen: aString size) = 0 ifFalse: [self socketError]! !

!Socket2 categoriesForMethods!
getBooleanOption:level:!operations!public! !
getSocketOption:level:into:!operations!public! !
setBooleanOption:level:value:!operations!public! !
setSocketOption:level:value:!operations!public! !
!

